# URL publica del backend (los free no pueden recibir red privada).
BACKEND_URL=http://127.0.0.1:8000
# Mismo valor que WHATSAPP_API_KEY del backend. Vacio = no manda header.
WHATSAPP_API_KEY=
# Un solo grupo. Pon WA_GROUP_NAME (nombre exacto del grupo, case-insensitive)
# o WA_GROUP_JID (12036...@g.us). Si dejas los dos vacios, el bot no responde a
# nadie pero loguea el JID de los grupos que ve, para que lo configures.
WA_GROUP_NAME=ceis
WA_GROUP_JID=
# Prefijos que tambien disparan respuesta, ademas de la mencion.
WA_TRIGGERS=!repre,/repre
# Throttle: segundos de espera por usuario, y tope global por minuto.
WA_COOLDOWN_SECONDS=20
WA_MAX_PER_MINUTE=6
WA_MAX_CHARS=1800
# Se auto-pinguea cada 10 min para que Render no lo duerma. OJO: eso consume
# casi toda la cuota de 750 horas-instancia/mes del workspace free.
WA_KEEPALIVE=true
# Clave para leer el QR por HTTP: /qr?token=... Sin esto, /qr devuelve 403 y el
# QR solo sale en los logs. Ponla larga y aleatoria; quien escanee el QR se
# queda con la sesion de WhatsApp.
WA_QR_TOKEN=
PORT=3000
