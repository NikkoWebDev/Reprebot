# Copia este archivo a .env y llena los valores
# GROQ_API_KEY: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
EMBEDDINGS_MODEL=jinaai/jina-embeddings-v2-base-es
CORS_ORIGINS=https://ceis-unal.com,https://www.ceis-unal.com,http://localhost:5173
ADMIN_TOKEN=

# Integración con el foro CEIS (Supabase, service role).
# Si están vacías, /api/forum/answer devuelve la respuesta pero no la publica
# (útil para probar sin Supabase).
# SUPABASE_SERVICE_KEY salta RLS: nunca debe salir del servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
FORUM_BOT_USER_ID=
FORUM_API_KEY=
FORUM_TAG_ALLOWLIST=Duda académica,Inscripciones y trámites,Bienestar
RATE_LIMIT_PER_MIN=20
