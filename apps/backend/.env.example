# Copia este archivo a .env y llena los valores
# GROQ_API_KEY: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
EMBEDDINGS_MODEL=jinaai/jina-embeddings-v2-base-es

# Embeddings por API remota (recomendado en hosts con poca RAM, ej. Render free).
# Si estas dos estan seteadas, fastembed no se carga y el proceso baja a ~150 MB.
# Con API remota cambie EMBEDDINGS_MODEL a jina-embeddings-v3 y EMBEDDINGS_DIM=1024,
# y reindexe: los vectores de un modelo no sirven para otro.
# EMBEDDINGS_API_URL=https://api.jina.ai/v1/embeddings
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_DIM=1024
CORS_ORIGINS=https://ceis-unal.com,https://www.ceis-unal.com,http://localhost:5173,http://localhost:4173
ADMIN_TOKEN=

# Integración con el foro CEIS (Supabase, service role).
# Si están vacías, /api/forum/answer devuelve la respuesta pero no la publica
# (útil para probar sin Supabase).
# SUPABASE_SERVICE_KEY salta RLS: nunca debe salir del servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
FORUM_BOT_USER_ID=
FORUM_API_KEY=
FORUM_TAG_ALLOWLIST=Duda académica,Inscripciones y trámites,Bienestar
RATE_LIMIT_PER_MIN=20

# Puente de WhatsApp (apps/whatsapp). Si WHATSAPP_API_KEY está vacío, el
# endpoint no pide header (igual que el foro). No hay rate limit por IP aquí:
# el puente throttlea por usuario.
WHATSAPP_API_KEY=
WHATSAPP_MAX_CHARS=1800
